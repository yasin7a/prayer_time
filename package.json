{
  "name": "namaz-reminder-tracker",
  "version": "1.0.0",
  "description": "Namaz Reminder & Tracker - a stable Electron prayer reminder app with local JSON persistence.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adhan": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.namaz.reminder",
    "productName": "Namaz Reminder & Tracker",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icons/logo.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
